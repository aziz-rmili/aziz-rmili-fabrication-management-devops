<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
    ============================================================
     PARENT SPRING BOOT
     C'est le "parent" qui gère automatiquement toutes les
     versions des bibliothèques pour nous.
     On n'a pas besoin d'écrire les versions manuellement.
    ============================================================
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
    </parent>

    <!--
    ============================================================
     IDENTIFICATION DU PROJET
     groupId  = nom de ton organisation (comme un package Java)
     artifactId = nom du projet
     version  = version actuelle
    ============================================================
    -->
    <groupId>com.gestion</groupId>
    <artifactId>fabrication</artifactId>
    <version>1.0.0</version>
    <name>Gestion des Ordres de Fabrication</name>

    <properties>
        <!-- On utilise Java 17 (version moderne et stable) -->
        <java.version>17</java.version>
    </properties>

    <dependencies>

        <!--
        ============================================================
         1. SPRING WEB
         Cours du prof slide 3 : Framework Spring Boot
         Permet de créer des endpoints REST (@RestController,
         @GetMapping, @PostMapping...)
         Sans cette dépendance : pas d'API REST possible.
        ============================================================
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
        ============================================================
         2. SPRING DATA JPA
         Cours du prof slide 3 : "Ajouter les dépendances
         MySQL et Spring-Data-JPA"
         Fournit JpaRepository avec toutes ses méthodes CRUD
         (save, findAll, findById, deleteById...)
         Gère Hibernate automatiquement en arrière-plan.
        ============================================================
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
        ============================================================
         3. SPRING VALIDATION
         Cours du prof slides 39-40 : "La validation des entités"
         Fournit les annotations de validation :
           @NotBlank  → champ ne doit pas être vide
           @NotNull   → champ ne doit pas être null
           @Min(1)    → valeur minimale
           @Size      → longueur min/max
           @Email     → doit être un email valide
           @Pattern   → validation par expression régulière
        ============================================================
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
        ============================================================
         4. CONNECTEUR MYSQL
         Cours du prof slide 10 : "Ajouter les dépendances MySQL"
         Permet à Spring Boot de se connecter à MySQL.
         scope="runtime" : utilisé seulement à l'exécution,
         pas pendant la compilation.
        ============================================================
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
        ============================================================
         5. LOMBOK
         Outil qui réduit le code répétitif.
         Au lieu d'écrire manuellement les getters/setters/
         constructeurs, on utilise des annotations :
           @Data           → génère getters + setters + equals + hashCode
           @NoArgsConstructor → génère constructeur sans paramètres
           @AllArgsConstructor → génère constructeur avec tous les paramètres
           @Builder        → pattern Builder
         IMPORTANT : requis par JPA pour le constructeur vide
        ============================================================
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
        ============================================================
         6. SPRINGDOC OPENAPI (SWAGGER)
         Génère automatiquement la documentation interactive de
         l'API à partir de tes annotations @RestController.
         Accessible sur : http://localhost:8080/swagger-ui.html
         Permet de tester tous tes endpoints sans Postman.
        ============================================================
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.3.0</version>
        </dependency>

        <!--
        ============================================================
         7. SPRING BOOT TEST
         Pour écrire et lancer les tests unitaires.
         scope="test" : utilisé seulement pendant les tests.
        ============================================================
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
            Plugin Maven Spring Boot : permet de lancer
            l'application avec la commande : mvn spring-boot:run
            et de créer le fichier JAR exécutable.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
